# SiteQuote Environment Variables Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL: Your project URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Safe for browser use, subject to Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# SUPABASE_SERVICE_ROLE_KEY: Admin secret key, server-side only. Keep private!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# -----------------------------------------------------------------------------
# Google Gemini API
# -----------------------------------------------------------------------------
# Required for AI quote generation in live mode.
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.8-flash"

# -----------------------------------------------------------------------------
# Application Behavior
# -----------------------------------------------------------------------------
# AI_MODE: "mock" (default for offline testing) or "live" (calls Google Gemini)
AI_MODE="mock"

# AUTH_MODE: "live" (uses Supabase Auth) or "mock" (local dev session fallback if Supabase not configured)
AUTH_MODE="live"

# NEXT_PUBLIC_APP_URL: Base URL of your app (used for public customer quote links)
# Local: http://localhost:3000 | Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
